# ═══════════════════════════════════════════════════════════════════════════════
#  Agentic Research Assistant — Environment Configuration
#  ✅ 100% FREE — No paid API keys required
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM: Ollama (local, free) ──────────────────────────────────────────────────
# Install Ollama from https://ollama.ai  then run:
#   ollama pull llama3.2      ← recommended (fast, good quality, ~2 GB)
#   ollama pull mistral       ← alternative
#   ollama pull gemma2        ← alternative
#   ollama serve              ← start the server

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embeddings: sentence-transformers (local, free) ───────────────────────────
# Model is downloaded automatically on first run (~90 MB to ~/.cache/huggingface)
# No configuration needed — change only if you want a different model.
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ── Database ───────────────────────────────────────────────────────────────────
# Development: SQLite (zero setup, default)
DATABASE_URL=sqlite+aiosqlite:///./data/research_assistant.db

# Production: PostgreSQL (uncomment and fill in)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/research_assistant

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production

# ── File Storage ───────────────────────────────────────────────────────────────
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50

# ── External APIs (all free, no keys required) ─────────────────────────────────
# arXiv: completely free, no key needed
ARXIV_USER_AGENT=AgenticResearchAssistant/0.1

# Semantic Scholar: free without a key (rate-limited); optionally add a key for
# higher limits — register free at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
